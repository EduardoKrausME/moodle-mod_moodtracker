{{!
    @template mod_moodtracker/checkin

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="moodtracker-checkin">
    {{#hasresponse}}
        <div class="alert alert-info" role="status">
            {{#canchange}}{{#str}} currentresponsechange, mod_moodtracker {{/str}}{{/canchange}}
            {{^canchange}}{{#str}} currentresponselocked, mod_moodtracker {{/str}}{{/canchange}}
        </div>
    {{/hasresponse}}

    <form method="post" action="{{action}}" class="moodtracker-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="submitmood" value="1">
        <div class="moodtracker-options" role="group" aria-label="{{#str}} choosemood, mod_moodtracker {{/str}}">
            {{#moods}}
                <button type="submit" name="moodvalue" value="{{value}}"
                        class="moodtracker-option{{#selected}} is-selected{{/selected}}"
                        title="{{label}}" aria-label="{{label}}" {{#disabled}}disabled{{/disabled}}>
                    <span class="moodtracker-emoji" aria-hidden="true">{{emoji}}</span>
                    <span class="moodtracker-label">{{label}}</span>
                </button>
            {{/moods}}
        </div>
    </form>

    {{#reporturl}}
        <div class="mt-4 text-center">
            <a class="btn btn-secondary" href="{{reporturl}}">{{#str}} viewreport, mod_moodtracker {{/str}}</a>
        </div>
    {{/reporturl}}
</div>
