{{!
    @template mod_moodtracker/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="moodtracker-report">
    <div class="moodtracker-summary mb-4">
        <strong>{{#str}} totalresponses, mod_moodtracker {{/str}}:</strong> {{total}}
        <span class="mx-2">•</span>
        <strong>{{#str}} participants, mod_moodtracker {{/str}}:</strong> {{participants}}
        <span class="mx-2">•</span>
        <strong>{{#str}} pendingresponses, mod_moodtracker {{/str}}:</strong> {{pending}}
    </div>

    <div class="moodtracker-chart" role="img" aria-label="{{#str}} chartaria, mod_moodtracker {{/str}}">
        {{#rows}}
            <div class="moodtracker-chart-row">
                <div class="moodtracker-chart-mood">
                    <span class="moodtracker-chart-emoji" aria-hidden="true">{{emoji}}</span>
                    <span>{{label}}</span>
                </div>
                <div class="moodtracker-chart-track">
                    <div class="moodtracker-chart-bar" style="width: {{barwidth}}%;"></div>
                </div>
                <div class="moodtracker-chart-value">{{count}} ({{percentage}}%)</div>
            </div>
        {{/rows}}
    </div>

    <div class="mt-4">
        <a class="btn btn-secondary" href="{{viewurl}}">{{#str}} backtoactivity, mod_moodtracker {{/str}}</a>
    </div>
</div>
